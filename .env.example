# Optional: Google Gemini API Key for contextual AI remediations
# If omitted, the linter runs 100% offline using deterministic rule templates
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: specify Gemini model (defaults to gemini-3.6-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# Server port
PORT=4000
